<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>3.2.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="NAudio" Version="3.2.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NAudio.Alsa" Version="3.2.0" />
    <PackageReference Include="NAudio.SoundFile" Version="3.2.0" />
  </ItemGroup>

  <!-- 當在 Windows 上編譯時，引進 WASAPI -->
  <ItemGroup Condition="$([System.String]::new('$(UserProfile)').StartsWith('C:')) or '$(OS)' == 'Windows_NT'">
    <PackageReference Include="NAudio.Wasapi" Version="3.2.0" />
  </ItemGroup>

  <!-- 當在 Linux 上編譯時，引進 ALSA 與 跨平台解碼庫 -->
  <ItemGroup Condition="'$(OS)' == 'Unix' and !$([MainProject]::Contains('Mac'))">
    <PackageReference Include="NAudio.Alsa" Version="3.2.0" />
    <!-- Linux 需要這個來讀取 MP3/FLAC/Ogg 等格式，因為 AudioFileReader 是 Windows 專屬 -->
    <PackageReference Include="NAudio.SoundFile" Version="3.2.0" />
  </ItemGroup>


  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nbl.Bridge\Nbl.Bridge.csproj" />
  </ItemGroup>
</Project>