{
  // 使用 IntelliSense 以得知可用的屬性。
  // 暫留以檢視現有屬性的描述。
  // 如需詳細資訊，請瀏覽: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Jest - 目前檔案（調試）",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "runtimeArgs": ["--experimental-vm-modules"],
      "args": ["${file}", "--runInBand", "--no-coverage"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Test File",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/pwa/node_modules/**"],
      "program": "${workspaceRoot}/pwa/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}", "--root", "${workspaceRoot}/pwa"],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "name": "NBL Desktop (dist) 得先跑 npx vite build",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-nbl-desktop",
      "program": "${workspaceFolder}/desktop/src/Nbl.Desktop/bin/Debug/net10.0/Nbl.Desktop.dll",
      "args": ["--source", "dist", "--dist-path", "${workspaceFolder}/pwa/dist"],
      "cwd": "${workspaceFolder}/desktop/src/Nbl.Desktop",
      "env": { "NBL_TRACE_FILE": "${workspaceFolder}/desktop/trace.log" },
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "NBL Desktop (dev: localhost:5173) 需先啟動 npm run dev",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-nbl-desktop",
      "program": "${workspaceFolder}/desktop/src/Nbl.Desktop/bin/Debug/net10.0/Nbl.Desktop.dll",
      "args": ["--source", "dev"],
      "cwd": "${workspaceFolder}/desktop/src/Nbl.Desktop",
      "env": { "NBL_TRACE_FILE": "${workspaceFolder}/desktop/trace.log" },
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "NBL Desktop (online)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-nbl-desktop",
      "program": "${workspaceFolder}/desktop/src/Nbl.Desktop/bin/Debug/net10.0/Nbl.Desktop.dll",
      "args": ["--source", "online"],
      "cwd": "${workspaceFolder}/desktop/src/Nbl.Desktop",
      "env": { "NBL_TRACE_FILE": "${workspaceFolder}/desktop/trace.log" },
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
